{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "How forgekit fits around a coding agent",
    "locale": "en",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "task-lane", "label": "Task" },
    { "id": "forgekit", "label": "forgekit" },
